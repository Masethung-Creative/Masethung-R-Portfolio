/**
 * Inline brand glyphs on a 24x24 grid, sized to sit optically level with the
 * Solar icon set used elsewhere.
 *
 * The source paths don't share a common bounding box — LinkedIn runs the full
 * 0→24 grid with no padding while GitHub and Instagram sit inside 2→22. Drawn
 * as-is, LinkedIn reads noticeably heavier and GitHub looks undersized next to
 * it. `scale` normalises each glyph around the centre so they occupy the same
 * optical area.
 */
interface Props {
  name: 'instagram' | 'github' | 'linkedin' | 'behance';
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

/** Per-glyph correction factor, applied about the 12,12 centre. */
const scales: Record<Props['name'], number> = {
  instagram: 1,
  github: 1,
  linkedin: 0.84,
  behance: 0.92,
};

const scale = scales[name];
/** Keeps the glyph centred while scaling: translate → scale → translate back. */
const transform =
  scale === 1 ? undefined : `translate(12 12) scale(${scale}) translate(-12 -12)`;

